generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DebtEntry {
  id           String    @id @default(cuid())
  customerName String    @map("customer_name")
  totalDebt    Decimal   @map("total_debt") @db.Decimal(12, 2)
  amountPaid   Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance      Decimal   @map("balance") @db.Decimal(12, 2)
  notes        String?
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  payments     Payment[]

  @@index([customerName])
  @@index([createdAt])
  @@map("debt_entries")
}

model Payment {
  id     String    @id @default(cuid())
  debtId String    @map("debt_id")
  amount Decimal   @db.Decimal(12, 2)
  paidBy String    @map("paid_by")
  note   String?
  paidAt DateTime  @default(now()) @map("paid_at")
  debt   DebtEntry @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("payments")
}

model InventoryItem {
  id         String      @id @default(cuid())
  itemName   String      @map("item_name")
  status     StockStatus @default(LOW_STOCK)
  reportedBy String      @map("reported_by")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  quantity   Int         @default(0)

  @@index([status])
  @@index([createdAt])
  @@map("inventory_items")
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  priceUnit Decimal  @map("price_unit") @db.Decimal(12, 2)
  unitName  String?  @default("pcs") @map("unit_name")
  priceBulk Decimal  @map("price_bulk") @db.Decimal(12, 2)
  bulkName  String?  @default("carton") @map("bulk_name")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("products")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

enum StockStatus {
  LOW_STOCK
  OUT_OF_STOCK
  RESTOCKED
}
